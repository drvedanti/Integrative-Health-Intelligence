<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">

<title>IHI — Integrative Health Intelligence</title>

<meta name="description"
content="Explore a health concern through modern medicine, Ayurveda and homeopathy.">

<style>
:root{
  --wine:#8b2035;
  --wine-dark:#681526;
  --gold:#b88a3b;
  --gold-soft:#f4e8d0;
  --cream:#fbf8f1;
  --paper:#fffdf9;
  --ink:#2c2524;
  --muted:#746b66;
  --green:#58745e;
  --red-soft:#fff4f3;
  --line:#e7ddd1;
  --shadow:0 16px 45px rgba(58,32,25,.08);
}

*{box-sizing:border-box}

html{scroll-behavior:smooth}

body{
  margin:0;
  background:var(--cream);
  color:var(--ink);
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,
  "Segoe UI",sans-serif;
  line-height:1.58;
}

button,textarea,select{
  font:inherit;
}

button{
  cursor:pointer;
}

.wrap{
  max-width:1120px;
  margin:auto;
  padding:0 22px;
}

/* HEADER */

header{
  padding:20px 0;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}

.brand{
  color:var(--wine);
  font-weight:950;
  letter-spacing:.08em;
  font-size:56px;
  line-height:1;
}

.brand small{
  display:block;
  color:var(--muted);
  font-size:11px;
  letter-spacing:.12em;
  margin-top:2px;
}

.lang{
  border:1px solid var(--line);
  background:var(--paper);
  border-radius:999px;
  padding:9px 12px;
  color:var(--ink);
}

/* HERO */

.hero{
  text-align:center;
  padding:58px 0 45px;
}

.kicker{
  display:inline-block;
  background:var(--gold-soft);
  color:#725522;
  border-radius:999px;
  padding:7px 13px;
  font-size:11px;
  font-weight:800;
  letter-spacing:.04em;
}

h1,h2,h3{
  font-family:Georgia,"Times New Roman",serif;
  font-weight:500;
  line-height:1.12;
}

h1{
  font-size:clamp(43px,7vw,72px);
  letter-spacing:-.035em;
  max-width:880px;
  margin:20px auto 17px;
}

.hero-copy{
  max-width:730px;
  margin:auto;
  color:var(--muted);
  font-size:18px;
}

/* CARDS */

.card{
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:25px;
  box-shadow:var(--shadow);
}

.input-card{
  max-width:850px;
  margin:34px auto 0;
  padding:24px;
  text-align:left;
}

.label{
  font-weight:800;
  font-size:16px;
  margin-bottom:9px;
  display:block;
}

.helper{
  font-size:13px;
  color:var(--muted);
  margin:-3px 0 12px;
}

textarea{
  width:100%;
  min-height:160px;
  border:1px solid var(--line);
  border-radius:18px;
  padding:17px;
  background:#fff;
  color:var(--ink);
  resize:vertical;
  outline:none;
}

textarea:focus{
  border-color:var(--gold);
  box-shadow:0 0 0 3px rgba(184,138,59,.13);
}

.actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:12px;
}

.btn{
  border:0;
  border-radius:999px;
  padding:12px 18px;
  font-weight:800;
}

.primary{
  background:var(--wine);
  color:#fff;
}

.primary:hover{
  background:var(--wine-dark);
}

.secondary{
  background:var(--gold-soft);
  color:#6c5124;
}

#speak{
  min-width:118px;
}

#speak.listening{
  background:#f8dfe2;
  color:var(--wine);
  border:1px solid #e5b9c0;
}

#speak.listening::after{
  content:" •";
  font-weight:900;
}

.outline{
  background:transparent;
  border:1px solid var(--line);
}

.example{
  margin-top:14px;
  color:var(--wine);
  font-size:13px;
  text-decoration:underline;
  cursor:pointer;
}

.disclaimer{
  border-top:1px solid var(--line);
  margin-top:16px;
  padding-top:13px;
  color:var(--muted);
  font-size:12px;
}

/* RESULTS */

main{
  display:none;
  padding-bottom:80px;
}

.section{
  padding:38px 0;
}

.section h2{
  font-size:38px;
  margin:0 0 10px;
}

.section-intro{
  max-width:760px;
  color:var(--muted);
  margin:0;
}

.story-card{
  padding:25px;
  margin-top:19px;
}

.story-text{
  font-size:17px;
  margin:10px 0 0;
}

.story-facts{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:17px;
}

.fact{
  background:#f3eee8;
  border-radius:999px;
  padding:7px 10px;
  font-size:12px;
  color:#5f5752;
}

/* APPROACHES */

.approach-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
  margin-top:20px;
}

.approach{
  padding:23px;
  text-align:left;
  border:1px solid var(--line);
  background:var(--paper);
  border-radius:24px;
  transition:.15s ease;
}

.approach:hover{
  transform:translateY(-2px);
  border-color:var(--gold);
}

.approach-icon{
  font-size:28px;
  margin-bottom:10px;
}

.approach h3{
  font-size:27px;
  margin:8px 0 8px;
}

.approach p{
  color:var(--muted);
  font-size:14px;
  margin:0;
}

.badge{
  display:inline-block;
  border-radius:999px;
  padding:5px 9px;
  font-size:10px;
  font-weight:850;
  letter-spacing:.04em;
}

.badge.modern{
  background:#e7f0e9;
  color:#45624d;
}

.badge.traditional{
  background:var(--gold-soft);
  color:#755a2b;
}

/* EXPLORER */

.explorer{
  display:none;
}

.explorer-card{
  padding:27px;
}

.explorer-card h2{
  margin-top:9px;
}

.question{
  margin-top:26px;
}

.question h3{
  font-size:22px;
  margin:0 0 12px;
}

.answers{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:9px;
}

.answer{
  padding:13px 14px;
  border:1px solid var(--line);
  border-radius:14px;
  background:#fff;
  text-align:left;
  color:var(--ink);
}

.answer:hover{
  border-color:var(--gold);
}

.answer.selected{
  border-color:var(--wine);
  background:#fbeced;
}

.explorer-action{
  margin-top:25px;
}

.explorer-result{
  display:none;
  margin-top:25px;
}

.result-card{
  padding:24px;
}

.result-card h3{
  font-size:28px;
  margin:0 0 9px;
}

.result-card p{
  color:var(--muted);
}

.pills{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}

.pill{
  padding:7px 10px;
  border-radius:999px;
  background:#f3eee8;
  font-size:12px;
}

.evidence{
  margin-top:15px;
  padding:13px;
  border-radius:14px;
  background:#f6f1ea;
  color:#665e58;
  font-size:12px;
}

.next-actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:17px;
}

.next-actions button{
  border:1px solid var(--line);
  background:var(--paper);
  border-radius:999px;
  padding:10px 14px;
  font-weight:750;
}

/* CONNECTIONS */

.connection-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-top:20px;
}

.connection{
  padding:19px;
}

.connection h3{
  font-size:21px;
  margin:0 0 6px;
}

.connection p{
  margin:0;
  color:var(--muted);
  font-size:13px;
}

/* COMFORT */

.comfort{
  padding:24px;
}

.comfort h3{
  font-size:26px;
  margin:0 0 10px;
}

.comfort p{
  color:var(--muted);
}

/* SAFETY */

.safety{
  padding:24px;
  background:var(--red-soft);
  border-color:#e8cccc;
}

.safety h3{
  color:var(--wine);
  font-size:27px;
  margin:0 0 10px;
}

.safety ul{
  margin:0;
  padding-left:20px;
}

.safety li{
  margin:8px 0;
  color:#655d59;
}

/* FOOTER */

.footer{
  border-top:0;
  padding:34px 0 52px;
  color:var(--muted);
  font-size:12px;
}

.footer-name{
  color:var(--ink);
  font-weight:750;
}

.toast{
  position:fixed;
  left:50%;
  bottom:20px;
  transform:translateX(-50%);
  display:none;
  background:var(--ink);
  color:#fff;
  padding:11px 16px;
  border-radius:999px;
  font-size:13px;
  z-index:20;
}

/* UPGRADED INTERACTION LAYER */

.health-terms{
  margin-top:14px;
  padding:18px 20px;
  box-shadow:none;
}

.term-heading{
  font-weight:800;
  margin-bottom:10px;
}

.term-row{
  display:grid;
  grid-template-columns:minmax(180px,.55fr) 1fr;
  gap:14px;
  padding:10px 0;
  border-top:1px solid var(--line);
  font-size:13px;
}

.term-row span,.term-empty{
  color:var(--muted);
}

.framework-learning{
  margin-top:18px;
  padding:18px;
  border-radius:18px;
  background:#f8f1e5;
  border:1px solid #eadcc5;
}

.learning-title{
  font-family:Georgia,"Times New Roman",serif;
  font-size:24px;
  margin-bottom:7px;
}

.learning-core,.learning-evidence{
  margin-top:10px;
  padding:10px 12px;
  border-radius:12px;
  background:rgba(255,255,255,.65);
  font-size:12px;
}

.learning-evidence{
  color:#665e58;
}

.question-progress{margin-bottom:18px}
.progress-label{font-size:12px;color:var(--muted);margin-bottom:7px}
.progress-track{height:6px;background:#eee5da;border-radius:999px;overflow:hidden}
.progress-fill{height:100%;background:var(--wine);transition:width .2s ease}
.question-card{padding-top:4px}
.question-why{margin:8px 0 14px;padding:10px 12px;border-left:3px solid var(--gold);background:#faf6ef;color:var(--muted);font-size:12px}
.question-why strong{color:var(--ink);margin-right:4px}
.option-list{display:grid;gap:9px;margin-top:15px}
.option-button{display:flex;align-items:flex-start;gap:10px;width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:14px;background:#fff;text-align:left;color:var(--ink);transition:.15s ease}
.option-button:hover{border-color:var(--gold)}
.option-button.selected{border-color:var(--wine);background:#fbeced}
.option-dot{width:17px;height:17px;border:1px solid #b9aea5;border-radius:5px;flex:0 0 auto;margin-top:2px}
.option-button.selected .option-dot{border:5px solid var(--wine);background:#fff}
.question-actions{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:18px}
.primary-button{border:0;border-radius:999px;background:var(--wine);color:#fff;font-weight:800;padding:11px 16px}
.primary-button:disabled{opacity:.45;cursor:not-allowed}
.text-button{border:0;background:transparent;color:var(--muted);padding:10px}
.result-panel{padding:22px;border:1px solid var(--line);border-radius:20px;background:var(--paper)}
.result-kicker{font-size:11px;font-weight:850;letter-spacing:.05em;color:var(--wine);margin-bottom:8px}
.result-panel h3{font-size:28px;margin:0 0 8px}
.result-intro{color:var(--muted)}
.result-group{margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}
.result-group h4{margin:0 0 8px}
.result-group li{margin:7px 0;color:#5f5752}
.result-boundary,.framework-boundary{margin-top:18px;padding:13px;border-radius:14px;background:#f6f1ea;font-size:12px;color:#665e58}
.result-boundary strong,.framework-boundary strong{color:var(--ink)}
.connected-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:12px}
.connected-node{border:1px solid var(--line);background:#fff;border-radius:14px;padding:12px;text-align:left;font-size:12px}
.connected-node.selected{border-color:var(--wine);background:#fbeced}
.node-number{display:block;font-weight:800;color:var(--gold);margin-bottom:5px}
.connected-detail{margin-top:12px;padding:14px;border-radius:14px;background:#f7f1e9;color:#625a55;font-size:13px}
.comfort-card{padding:16px;border:1px solid var(--line);border-radius:16px;margin-bottom:10px}
.comfort-card h3{font-size:20px;margin:0 0 8px}
.comfort-card li{margin:7px 0;color:#625a55;font-size:13px}
.own-words{margin-top:14px;padding:14px;border-radius:14px;background:#faf6ef;border:1px solid var(--line)}
.own-words label{display:block;font-weight:800;font-size:13px;margin-bottom:7px}
.own-words textarea{min-height:92px;background:#fff}
.selection-hint{font-size:12px;color:var(--muted);margin:7px 0 0}
.dynamic-explanation{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:18px}
.explanation-card{padding:17px;border:1px solid var(--line);border-radius:16px;background:var(--paper)}
.explanation-card h3{font-size:19px;margin:0 0 7px}
.explanation-card p{margin:0;color:var(--muted);font-size:13px}
@media(max-width:800px){.dynamic-explanation{grid-template-columns:1fr}}
body:before,body:after{display:none!important;content:none!important}

/* MOBILE */

@media(max-width:800px){

  .brand{font-size:34px}
  .brand small{font-size:9px}

  .approach-grid{
    grid-template-columns:1fr;
  }

  .connection-grid{
    grid-template-columns:1fr 1fr;
  }

  .answers{
    grid-template-columns:1fr;
  }

  .hero{
    padding-top:38px;
  }

  .hero-copy{
    font-size:16px;
  }

  h1{
    font-size:46px;
  }
}

@media(max-width:500px){

  .connection-grid{
    grid-template-columns:1fr;
  }

}
</style>
</head>

<body>

<div class="wrap">

<header>

  <div class="brand">
    IHI
    <small>INTEGRATIVE HEALTH INTELLIGENCE</small>
  </div>

  <select class="lang" id="languageSelect" aria-label="Choose language">
    <option value="en">English</option>
    <option value="hiEn">हिंदी + English</option>
    <option value="hi">हिंदी</option>
    <option value="mrEn">मराठी + English</option>
    <option value="mr">मराठी</option>
  </select>

</header>


<section class="hero">

  <span class="kicker" id="kicker">
    UNDERSTAND WHAT'S HAPPENING
  </span>

  <h1 id="heroTitle">
    Something doesn't feel right.<br>
    Let's understand why.
  </h1>

  <p class="hero-copy" id="heroCopy">
    Tell us what's happening in your own words.
    Explore different ways of understanding it —
    from modern medicine to Ayurveda and homeopathy.
  </p>


  <div class="card input-card">

    <label class="label" id="inputLabel" for="concern">
      What's happening?
    </label>

    <div class="helper" id="inputHelper">
      Tell us what you've noticed. No medical words needed.
    </div>

    <textarea id="concernInput"
      placeholder="Example: I've been having acidity and bloating after meals..."
    ></textarea>

    <div class="actions">

      <button type="button" class="btn secondary" id="speakBtn">
        🎙 <span class="speak-label" id="speakText">Speak</span>
      </button>

      <button type="button" class="btn primary" id="startBtn"
        Start exploring →
      </button>

    </div>

    <div class="example" id="example">
      Try an example
    </div>

    <div class="disclaimer" id="disclaimer">
      IHI is an exploration tool, not a diagnosis or treatment system.
    </div>

  </div>

</section>


<main id="results">

  <!-- STORY -->

  <section class="section">

    <h2 id="understoodTitle">
      Here's what we heard.
    </h2>

    <p class="section-intro" id="understoodIntro">
      We picked out the main things you told us.
      You can correct anything that doesn't sound right.
    </p>

    <div class="card story-card">

      <span class="badge modern" id="storyBadge">
        YOUR STORY
      </span>

      <p class="story-text" id="storyText"></p>

      <div class="story-facts" id="storyFacts"></div>

    </div>

    <div class="card health-terms" id="healthTerms">
      <div class="term-heading">What do these words mean?</div>
      <div class="term-empty">We’ll explain familiar health terms when this prototype can confidently map them.</div>
    </div>

  </section>


  <!-- APPROACH SELECTION -->

  <section class="section">

    <h2 id="chooseTitle">
      What do you want to explore?
    </h2>

    <p class="section-intro" id="chooseIntro">
      Choose one approach to start.
      You can explore another one later.
    </p>

    <div class="approach-grid">


      <button class="approach" data-approach="modern">

        <div class="approach-icon">🩺</div>

        <span class="badge modern">
          MODERN MEDICINE
        </span>

        <h3 id="modernChoice">
          Modern Medicine
        </h3>

        <p id="modernChoiceText">
          How does modern medicine understand this?
        </p>

      </button>


      <button class="approach" data-approach="ayur">

        <div class="approach-icon">🌿</div>

        <span class="badge traditional">
          AYURVEDA
        </span>

        <h3 id="ayurChoice">
          Ayurveda
        </h3>

        <p id="ayurChoiceText">
          How does Ayurveda understand this?
        </p>

      </button>


      <button class="approach" data-approach="homeo">

        <div class="approach-icon">◌</div>

        <span class="badge traditional">
          HOMEOPATHY
        </span>

        <h3 id="homeoChoice">
          Homeopathy
        </h3>

        <p id="homeoChoiceText">
          How does Homeopathy understand this?
        </p>

      </button>


    </div>

  </section>


  <!-- INTERACTIVE EXPLORER -->

  <section class="section explorer" id="explorer">

    <div class="card explorer-card">

      <span class="badge" id="explorerBadge">
        MODERN MEDICINE
      </span>

      <h2 id="explorerTitle">
        What could be happening in the body?
      </h2>

      <p class="section-intro" id="explorerIntro">
        Let's narrow down the pattern with a few simple questions.
      </p>

      <div class="framework-learning" id="frameworkLearning"></div>

      <div id="questions"></div>



      <div class="explorer-result" id="explorerResult">

        <div class="card result-card">

          <h3 id="resultTitle">
            What your answers suggest
          </h3>

          <p id="resultText"></p>

          <div class="pills" id="resultPills"></div>

          <div class="evidence" id="evidenceNote"></div>

        </div>


        <div class="next-actions">

          <button id="anotherBtn">
            Explore another approach
          </button>

          <button id="newBtn">
            Start a new question
          </button>

        </div>

      </div>

    </div>

  </section>


  <!-- PATTERN EXPLANATION -->

  <section class="section">

    <h2 id="connectedTitle">
      What could help explain this pattern?
    </h2>

    <p class="section-intro" id="connectedIntro">
      A plain-language explanation of what may be involved, what can influence it, and what would change the interpretation.
    </p>

    <div class="dynamic-explanation" id="connections"></div>

  </section>


  <!-- COMFORT -->

  <section class="section">

    <h2 id="comfortTitle">
      Things you can consider for comfort
    </h2>

    <p class="section-intro" id="comfortIntro">
      Simple ideas and traditional practices, clearly labelled.
      They are not cures.
    </p>

    <div class="card comfort" id="comfortCard"></div>

  </section>


  <!-- SAFETY -->

  <section class="section" id="safetySection" style="display:none">

    <div class="card safety">

      <h3 id="safetyTitle">
        When to get urgent help
      </h3>

      <ul id="safetyList"></ul>

    </div>

  </section>

</main>


<footer class="footer">

  <div class="footer-name">
    IHI — Integrative Health Intelligence
  </div>

  <div style="margin-top:7px" id="footerLine">
    Understand what's happening.
    Explore what it could mean.
  </div>

  <div style="margin-top:10px">
    A product concept by <strong>Dr. Vedanti Shah</strong>.
  </div>

  <div style="margin-top:12px">
    IHI does not diagnose, prescribe, or replace qualified medical care.
    Traditional frameworks are presented as distinct frameworks and
    do not share the same evidence base.
  </div>

</footer>

</div>


<div class="toast" id="toast"></div>

 <script>
/* =========================================================
   IHI — INTERACTIVE PRODUCT LOGIC
   Chunk 2: language + exploration data
   ========================================================= */

const state = {
  language: "en",
  concern: "",
  framework: null,
  questionIndex: 0,
  answers: {},
  transcript: ""
};


/* ---------------------------------------------------------
   LANGUAGE CONTENT
   --------------------------------------------------------- */

const LANG = {

  en: {
    heroKicker: "UNDERSTAND WHAT'S HAPPENING",
    heroTitle: "Something doesn't feel right. Let's understand why.",
    heroText:
      "Tell us what's happening in your own words. Explore different ways of understanding it — from modern medicine to Ayurveda and homeopathy.",

    concernLabel: "What's happening?",
    concernHint: "Tell us what you've noticed. No medical words needed.",
    placeholder:
      "For example: I've been feeling bloated after meals and sometimes I get a burning feeling in my chest.",
    speak: "Speak",
    exploring: "Start exploring",
    example: "Try an everyday description — you can mix languages naturally when speaking.",
    disclaimer:
      "IHI is an educational exploration tool, not a diagnosis or a substitute for medical care.",

    heardTitle: "Here's what we heard.",
    heardText:
      "We picked out the main things you told us.
You can correct anything that doesn't sound right.
    </p>

    <div class="card story-card">

      <span class="badge modern" id="storyBadge">
        YOUR STORY
      </span>

