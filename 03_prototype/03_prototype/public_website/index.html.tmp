/* =========================================================
   QUESTIONS
   ========================================================= */

function renderQuestion() {

  if (!state.framework) return;

  const framework =
    FRAMEWORKS[state.framework];

  const questions =
    framework.questions[state.language] ||
    framework.questions.en;

  const question =
    questions[state.questionIndex];

  const container =
    $("questions");

  if (!container || !question) return;

  const total =
    questions.length;

  container.innerHTML = `
    <div class="question-progress">
      ${escapeHTML(String(state.questionIndex + 1))} / ${escapeHTML(String(total))}
    </div>

    <h3>
      ${escapeHTML(question.text)}
    </h3>

    <div class="question-options">
      ${question.options.map((option,index)=>`
        <button
          type="button"
          class="question-option"
          data-option="${index}"
        >
          ${escapeHTML(option)}
        </button>
      `).join("")}
    </div>

    <div class="question-actions">
      <button
        type="button"
        class="secondary-btn"
        id="backQuestion"
        ${state.questionIndex === 0 ? "disabled" : ""}
      >
        ${
          state.language === "hi"
            ? "पीछे"
            : state.language === "mr"
              ? "मागे"
              : "Back"
        }
      </button>

      <button
        type="button"
        class="primary-btn"
        id="nextQuestion"
        disabled
      >
        ${
          state.questionIndex === total - 1
            ? (
              state.language === "hi"
                ? "परिणाम देखें"
                : state.language === "mr"
                  ? "परिणाम पाहा"
                  : "See what this may suggest"
            )
            : (
              state.language === "hi"
                ? "आगे"
                : state.language === "mr"
                  ? "पुढे"
                  : "Next"
            )
        }
      </button>
    </div>
  `;

  container
    .querySelectorAll(".question-option")
    .forEach(button => {

      button.addEventListener("click", () => {

        container
          .querySelectorAll(".question-option")
          .forEach(item => {
            item.classList.remove("selected");
          });

        button.classList.add("selected");

        state.answers[state.questionIndex] =
          button.textContent.trim();

        const next =
          $("nextQuestion");

        if (next) {
          next.disabled = false;
        }

      });

    });

  const next =
    $("nextQuestion");

  if (next) {

    next.addEventListener("click", () => {

      if (
        state.questionIndex <
        total - 1
      ) {

        state.questionIndex++;

        renderQuestion();

      } else {

        renderFrameworkResult();

      }

    });

  }

  const back =
    $("backQuestion");

  if (back) {

    back.addEventListener("click", () => {

      if (state.questionIndex > 0) {

        state.questionIndex--;

        renderQuestion();

      }

    });

  }

}
/* =========================================================
   FRAMEWORK RESULT
   ========================================================= */

function renderFrameworkResult() {

  const framework =
    FRAMEWORKS[state.framework];

  if (!framework) return;

  const result =
    framework.results[state.language] ||
    framework.results.en;

  const output =
    $("explorerResult");

  if (!output) return;

  output.innerHTML = `
    <div class="framework-result-card">

      <div class="result-label">
        ${escapeHTML(result.label)}
      </div>

      <h3>
        ${escapeHTML(result.title)}
      </h3>

      <p>
        ${escapeHTML(result.body)}
      </p>

      <div class="answer-summary">

        <strong>
          ${
            UI_COPY[state.language]?.answersTitle ||
            UI_COPY.en.answersTitle
          }
        </strong>

        <ul>
          ${
            Object.values(state.answers).length
              ? Object.values(state.answers)
                  .map(answer =>
                    `<li>${escapeHTML(answer)}</li>`
                  )
                  .join("")
              : `<li>${
                  state.language === "hi"
                    ? "अभी कोई अतिरिक्त उत्तर नहीं चुना गया।"
                    : state.language === "mr"
                      ? "अजून कोणताही अतिरिक्त उत्तर निवडलेला नाही."
                      : "No additional answers selected yet."
                }</li>`
          }
        </ul>

      </div>

    </div>
  `;

  output.style.display = "block";

  output.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

}
function getComplaintProfile(){
  const t=(state.concern||"").toLowerCase();
  if(/pimple|pimples|acne|मुंहासे|मुँहासे|पिंपल|पुरळ|acne/.test(t)) return COMPLAINT_PROFILES.acne;
  if(/headache|migraine|सिर दर्द|सिरदर्द|डोकेदुखी|अर्धशिशी/.test(t)) return COMPLAINT_PROFILES.headache;
  if(/cough|खांसी|खोकला/.test(t)) return COMPLAINT_PROFILES.cough;
  if(/fever|बुखार|ताप/.test(t)) return COMPLAINT_PROFILES.fever;
  if(/rash|रैश|पुरळ|त्वचेवर पुरळ/.test(t)) return COMPLAINT_PROFILES.rash;
  if(/acidity|bloating|gas|indigestion|अपच|एसिडिटी|गैस|फुलना|आम्लपित्त|पोट फुगणे/.test(t)) return COMPLAINT_PROFILES.digestive;
  return COMPLAINT_PROFILES.general;
}

function renderConnectedPattern(){
  renderPatternExplanation();

  const result=$("connections");
  if(!result) return;
const concernSummary = document.createElement("div");

concernSummary.className = "concern-summary";

concernSummary.innerHTML = `
  <div class="result-group">
    <h4>
      ${
        state.language === "en"
          ? "Based on what you told us"
          : state.language === "hiEn"
            ? "आपने जो बताया, उसके आधार पर"
            : state.language === "hi"
              ? "आपने जो बताया, उसके आधार पर"
              : state.language === "mrEn"
                ? "तुम्ही जे सांगितलं त्यावर आधारित"
                : "तुम्ही जे सांगितलं त्यावर आधारित"
      }
    </h4>

    <p>
      ${escapeHTML(state.concern)}
    </p>
  </div>
`;

const panel = result.querySelector(".result-panel");

if (panel) {
  panel.insertBefore(
    concernSummary,
    panel.children[1] || null
  );
}
  result.classList.add("visible");

  result.scrollIntoView({
    behavior:"smooth",
    block:"center"
  });
}


/* =========================================================
   COMFORT & SELF-CARE
   ========================================================= */

function renderComfort(){

  const container=$("comfortCard");

  if(!container) return;

  const profile=getComplaintProfile();
  const lang=state.language;

  const items =
    COMFORT_DYNAMIC[lang]?.[profile.key] ||
    COMFORT_DYNAMIC.en[profile.key] ||
    COMFORT_DYNAMIC.en.general;

  const title =
    COMFORT_TITLES[lang] ||
    COMFORT_TITLES.en;

  const intro =
    COMFORT_INTROS[lang] ||
    COMFORT_INTROS.en;

  container.innerHTML=`
    <div class="comfort-header">
      <div>
        <div class="section-kicker">${escapeHTML(title)}</div>
        <h3>${escapeHTML(intro)}</h3>
      </div>
    </div>

    <div class="comfort-list">
      ${items.map(item=>`
        <div class="comfort-item">
          <div class="comfort-item-title">
            ${escapeHTML(item.title)}
          </div>

          <div class="comfort-item-text">
            ${escapeHTML(item.text)}
          </div>

          ${
            item.note
              ? `<div class="comfort-item-note">${escapeHTML(item.note)}</div>`
              : ""
          }
        </div>
      `).join("")}
    </div>
  `;

  container.classList.add("visible");
}
/* =========================================================
   SAFETY
   ========================================================= */

function renderSafety(){

  const container=$("safetyList");

  if(!container) return;

  const profile=getComplaintProfile();

  const safety =
    profile.safety ||
    COMPLAINT_PROFILES.general.safety;

  const title =
    state.language === "hi"
      ? "कब तुरंत मदद लेनी चाहिए"
      : state.language === "mr"
        ? "कधी तातडीने मदत घ्यावी"
        : "When to seek urgent help";

  container.innerHTML=`
    <div class="safety-card">
      <h3>${escapeHTML(title)}</h3>

      <ul>
        ${safety.map(item=>`
          <li>${escapeHTML(item)}</li>
        `).join("")}
      </ul>
    </div>
  `;

  container.classList.add("visible");
}


