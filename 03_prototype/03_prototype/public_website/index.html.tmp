/* =========================================================
   NEW STORY
   ========================================================= */

const newBtn=$("newBtn");

if(newBtn){

  newBtn.addEventListener("click",()=>{

    state.concern="";
    state.framework=null;
    state.questionIndex=0;
    state.answers={};
    state.ownWords={};
    state.transcript="";

    const input=$("concern");

    if(input){
      input.value="";
    }

    const results=$("results");

    if(results){
      results.style.display="none";
    }

    window.scrollTo({
      top:0,
      behavior:"smooth"
    });

  });

}
recognition.continuous = false;
recognition.interimResults = true;
recognition.lang = getSpeechLanguage();

recognition.onstart = () => {

  isListening = true;

  button.classList.add("listening");
  button.setAttribute("aria-pressed","true");

  const message =
    state.language === "hi"
      ? "सुन रहा हूँ…"
      : state.language === "mr"
        ? "ऐकतोय…"
        : "Listening…";

  showToast(message);

};


recognition.onresult = event => {

  let transcript = "";

  for (
    let i = event.resultIndex;
    i < event.results.length;
    i++
  ) {

    transcript +=
      event.results[i][0].transcript;

  }

  state.transcript = transcript;

  const input =
    $("concern");

  if (input) {
    input.value = transcript;
  }

};


recognition.onerror = event => {

  isListening = false;

  button.classList.remove("listening");
  button.setAttribute("aria-pressed","false");

  let message =
    state.language === "hi"
      ? "आवाज़ समझने में समस्या हुई। आप टाइप भी कर सकते हैं।"
      : state.language === "mr"
        ? "आवाज समजण्यात अडचण आली. तुम्ही टाइपही करू शकता."
        : "I couldn't understand the voice input. You can type instead.";

  if (event.error === "not-allowed") {

    message =
      state.language === "hi"
        ? "Microphone की अनुमति दें, फिर दोबारा कोशिश करें।"
        : state.language === "mr"
          ? "Microphone ची परवानगी द्या आणि पुन्हा प्रयत्न करा."
          : "Allow microphone access and try again.";

  }

  showToast(message);

};


recognition.onend = () => {

  isListening = false;

  button.classList.remove("listening");
  button.setAttribute("aria-pressed","false");

};


button.addEventListener("click", () => {

  if (isListening) {

    recognition.stop();

    return;

  }

  recognition.lang =
    getSpeechLanguage();

  try {

    recognition.start();

  } catch(error) {

    showToast(
      state.language === "hi"
        ? "Voice input शुरू नहीं हो सका।"
        : state.language === "mr"
          ? "Voice input सुरू करता आला नाही."
          : "Voice input could not start."
    );

  }

});

}
/* =========================================================
   MAIN EXPLORATION
   ========================================================= */

function startExploration(){

  const input =
    $("concern");

  if(!input) return;

  const concern =
    input.value.trim();

  if(!concern){

    showToast(
      state.language === "hi"
        ? "पहले बताएं कि क्या हो रहा है।"
        : state.language === "mr"
          ? "आधी काय होतंय ते सांगा."
          : "Tell us what's happening first."
    );

    input.focus();

    return;
  }

  state.concern =
    concern;

  state.framework =
    null;

  state.questionIndex =
    0;

  state.answers =
    {};

  state.ownWords =
    {};

  renderStory();

  const results =
    $("results");

  if(results){

    results.style.display =
      "block";

    results.classList.add(
      "visible"
    );

  }

  const explorer =
    $("explorer");

  if(explorer){

    explorer.style.display =
      "block";

  }

  updateSafetyVisibility();

  renderComfort();

  renderSafety();

  results?.scrollIntoView({
    behavior:"smooth",
    block:"start"
  });

}


/* =========================================================
   LANGUAGE CHANGE
   ========================================================= */

const languageSelect =
  $("language");

if(languageSelect){

  languageSelect.addEventListener(
    "change",
    () => {

      state.language =
        languageSelect.value;

      if(recognition){
        recognition.lang =
          getSpeechLanguage();
      }

      applyLanguage();

      if(state.concern){

        renderStory();

        if(state.framework){

          renderFrameworkIntro();
          renderQuestion();

        }

        renderComfort();
        updateSafetyVisibility();

      }

    }
  );

}


/* =========================================================
   START BUTTON
   ========================================================= */

const exploreButton =
  $("explore");

if(exploreButton){

  exploreButton.addEventListener(
    "click",
    startExploration
  );

}
function applyLanguage(){

  const l = getLang();

  const setText = (id, value) => {
    const el = $(id);
    if (el && value) el.textContent = value;
  };

  setText("kicker", l.heroKicker);
  setText("heroTitle", l.heroTitle);
  setText("heroCopy", l.heroText);

  setText("inputLabel", l.concernLabel);
  setText("inputHelper", l.concernHint);

  const input = $("concern");
  if (input) input.placeholder = l.placeholder;

  setText("speakText", l.speak);
  setText("explore", l.exploring);
  setText("example", l.example);
  setText("disclaimer", l.disclaimer);

  setText("understoodTitle", l.heardTitle);
  setText("understoodIntro", l.heardText);

  setText("chooseTitle", l.exploreTitle);
  setText("chooseIntro", l.chooseIntro);

  setText("modernChoice", l.modern);
  setText("modernChoiceText", l.modernSub);

  setText("ayurChoice", l.ayurveda);
  setText("ayurChoiceText", l.ayurvedaSub);

  setText("homeoChoice", l.homeopathy);
  setText("homeoChoiceText", l.homeopathySub);

  setText("comfortTitle", l.comfortTitle);
  setText("comfortIntro", l.comfortIntro);

  setText("safetyTitle", l.safetyTitle);

  updateFrameworkLabels();

  if (state.concern) {
    renderStory();

    if (state.framework) {
      renderFrameworkIntro();
      renderQuestion();
    }

    renderComfort();
    updateSafetyVisibility();
  }
}



/* =========================================================
   FRAMEWORK LABELS
   ========================================================= */

function updateFrameworkLabels(){

  const cards =
    document.querySelectorAll(".approach");

  const labels = {
    en: {
      modern: "MODERN MEDICINE",
      ayurveda: "AYURVEDA",
      homeopathy: "HOMEOPATHY"
    },
    hiEn: {
      modern: "MODERN MEDICINE",
      ayurveda: "AYURVEDA",
      homeopathy: "HOMEOPATHY"
    },
    hi: {
      modern: "आधुनिक चिकित्सा",
      ayurveda: "आयुर्वेद",
      homeopathy: "होम्योपैथी"
    },
    mrEn: {
      modern: "MODERN MEDICINE",
      ayurveda: "AYURVEDA",
      homeopathy: "HOMEOPATHY"
    },
    mr: {
      modern: "आधुनिक वैद्यक",
      ayurveda: "आयुर्वेद",
      homeopathy: "होमिओपॅथी"
    }
  };

  cards.forEach(card => {

    const framework =
      card.dataset.approach === "ayur"
        ? "ayurveda"
        : card.dataset.approach === "homeo"
          ? "homeopathy"
          : "modern";

    const data =
      FRAMEWORKS[framework];

    if (!data) return;

    const localized =
      data.ui?.[state.language] ||
      data.ui?.en;

    const title =
      card.querySelector(".approach-title");

    const description =
      card.querySelector(".approach-description");

    const badge =
      card.querySelector(".badge");

    if (title && localized)
      title.textContent = localized.title;

    if (description && localized)
      description.textContent = localized.description;

    if (badge)
      badge.textContent =
        labels[state.language]?.[framework] ||
        labels.en[framework];

  });

}
/* =========================================================
   INITIALISE
   ========================================================= */

function init(){

  const selector =
    $("language");

  if(selector){

    selector.value =
      state.language;

  }

  applyLanguage();

  setupSpeech();

  const input =
    $("concern");

  if(input){

    input.addEventListener(
      "input",
      () => {

        state.concern =
          input.value;

        if(state.concern.trim()){
          updateSafetyVisibility();
        }

      }
    );

  }

}


/* =========================================================
   DOM READY
   ========================================================= */

if(
  document.readyState ===
  "loading"
){

  document.addEventListener(
    "DOMContentLoaded",
    init
  );

} else {

  init();

}
  /* =========================================================
     END OF INTERACTION ENGINE
     ========================================================= */

  /* Keep the final initialisation here.
     The page is now ready for interaction. */

  applyLanguage();
  updateFrameworkLabels();

  if (state.concern) {
    renderStory();
    updateSafetyVisibility();
  }
  /* =========================================================
     END
     ========================================================= */

</script>
</body>
</html>




















































